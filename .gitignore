# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos de cookie gerados pelo curl em testes manuais
cookies.txt
doador.txt
ong.txt

# editor e ferramentas pessoais
.VSCodeCounter/
.claude/settings.local.json

# impeccable (ferramenta de design com IA)
# Cada pessoa instala na própria máquina com:
#   npx impeccable install --providers=claude --project
# Por isso não versionamos a instalação (inclui um binário que só roda no Mac)
# nem as cópias no formato do GitHub Copilot.
.claude/skills/
.claude/agents/
.github/agents/
.github/hooks/
.github/skills/
# configurações pessoais e históricos de crítica
.impeccable/config.local.json
.impeccable/critique/
.impeccable/live/
