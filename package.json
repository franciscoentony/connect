{
  "name": "connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migrations:create": "node-pg-migrate create -m infra/migrations",
    "migrations:up": "node-pg-migrate up -m infra/migrations",
    "migrations:down": "node-pg-migrate down -m infra/migrations",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --import dotenv/config\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --import dotenv/config\" jest --watch",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.0",
    "next-swagger-doc": "^0.5.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-react": "^5.33.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/swagger-ui-react": "^5.18.0",
    "dotenv": "^18.0.5",
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4"
  }
}
